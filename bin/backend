#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Development may provide its own fresh interpreter environment. Flatpak uses /app.
if [ "$ROOT" = /app/share/narratorverse ]; then
  export PYTHONPATH="$ROOT/backend:/app/lib/python3.13/site-packages"
else
  export PYTHONPATH="$ROOT/backend${PYTHONPATH:+:$PYTHONPATH}"
fi
export QT_QPA_PLATFORM=offscreen
export QT_QUICK_BACKEND=software
export PYTHONDONTWRITEBYTECODE=1
exec python3 -m narratorverse.main "$@"